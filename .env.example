# Base de datos:
# En local usa SQLite por defecto
# DATABASE_URL=postgresql+psycopg://usuario:clave@host.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./data/jobs.db

# API de Gemini
GEMINI_API_KEY=clave
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=xhigh

# Proteccion basica para el despliegue en Vercel
APP_PASSWORD=

# Claves de portales
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=